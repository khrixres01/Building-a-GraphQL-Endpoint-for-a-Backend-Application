
# Azure AD / Microsoft Entra (do not commit real values)
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=__SET_IN_LOCAL_ENV_ONLY__

# Fabric GraphQL endpoint (single URL)
FABRIC_GRAPHQL_ENDPOINT=https://<region>.graphql.fabric.microsoft.com/v1/workspaces/<workspace-id>/graphqlapis/<api-id>/graphql

# Optional
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
